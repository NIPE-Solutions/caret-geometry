{
  "name": "@nipe-solutions/caret-geometry",
  "version": "0.1.0-alpha.0",
  "description": "Reliable caret geometry for inputs, textareas and editable DOM.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "vite --config site/vite.config.ts",
    "docs:build": "vite build --config site/vite.config.ts",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint .",
    "check": "npm run format && npm run lint && npm run typecheck && npm run test && npm run build && npm run docs:build && npm run package:verify",
    "package:verify": "node scripts/verify-package.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "release:dry-run": "npm run check && npm publish --dry-run",
    "prepublishOnly": "npm run check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NIPE-Solutions/caret-geometry.git"
  },
  "homepage": "https://caret-geometry.nipesolutions.com",
  "bugs": "https://github.com/NIPE-Solutions/caret-geometry/issues",
  "keywords": [
    "caret",
    "textarea",
    "input",
    "contenteditable",
    "selection",
    "range",
    "geometry",
    "floating-ui",
    "autocomplete",
    "mentions",
    "typescript",
    "browser"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@floating-ui/dom": "^1.7.4",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.13.3",
    "eslint": "^9.35.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
